const { initializeApp } = require('firebase-admin/app');
const { getFirestore } = require('firebase-admin/firestore');
const { getAuth } = require('firebase-admin/auth');
const { getStorage } = require('firebase-admin/storage');
const functions = require('firebase-functions');

// Initialize Firebase Admin
initializeApp();

// Initialize services
const db = getFirestore();
const auth = getAuth();
const storage = getStorage();

// Import modules
const authTriggers = require('./auth');
const firestoreTriggers = require('./firestore');
const realtimeTriggers = require('./realtime');
const storageTriggers = require('./storage');
const notifications = require('./notifications');
const sync = require('./sync');
const scheduled = require('./scheduled');
const security = require('./security');
const ai = require('./ai');
const webhooks = require('./webhooks');

// Auth triggers
exports.onUserCreate = authTriggers.onUserCreate;
exports.onUserDelete = authTriggers.onUserDelete;
exports.sendVerificationEmail = authTriggers.sendVerificationEmail;

// Firestore triggers
exports.onAssessmentCreate = firestoreTriggers.onAssessmentCreate;
exports.onAssessmentUpdate = firestoreTriggers.onAssessmentUpdate;
exports.onKeyVerified = firestoreTriggers.onKeyVerified;
exports.onIncidentCreate = firestoreTriggers.onIncidentCreate;

// Storage triggers
exports.onFileUpload = storageTriggers.onFileUpload;
exports.onFileDelete = storageTriggers.onFileDelete;
exports.compressImage = storageTriggers.compressImage;

// Notifications
exports.sendPushNotification = notifications.sendPushNotification;
exports.sendEmailNotification = notifications.sendEmailNotification;
exports.sendSecurityAlert = notifications.sendSecurityAlert;

// Sync functions
exports.syncToLaravel = sync.syncToLaravel;
exports.webhookLaravel = sync.webhookLaravel;
exports.handleConflict = sync.handleConflict;

// Scheduled functions
exports.dailyDigest = functions.pubsub.schedule('0 8 * * *').onRun(scheduled.dailyDigest);
exports.weeklyReport = functions.pubsub.schedule('0 9 * * 1').onRun(scheduled.weeklyReport);
exports.cleanExpiredTokens = functions.pubsub.schedule('0 2 * * *').onRun(scheduled.cleanExpiredTokens);
exports.healthCheck = functions.pubsub.schedule('*/5 * * * *').onRun(scheduled.healthCheck);

// Security functions
exports.detectSQLInjection = security.detectSQLInjection;
exports.rateLimiter = security.rateLimiter;
exports.auditLogger = security.auditLogger;

// AI functions
exports.analyzeThreat = ai.analyzeThreat;
exports.detectAnomaly = ai.detectAnomaly;
exports.generateCriteria = ai.generateCriteria;

// Webhooks
exports.laravelWebhook = webhooks.laravelWebhook;
exports.slackWebhook = webhooks.slackWebhook;

// Realtime triggers
exports.onPresenceUpdate = realtimeTriggers.onPresenceUpdate;
exports.onNotificationSent = realtimeTriggers.onNotificationSent;

// Export database and auth for other modules
module.exports.db = db;
module.exports.auth = auth;
module.exports.storage = storage;
